{
"update_url": "https://clients2.google.com/service/update2/crx",

    "manifest_version": 3,
    "name": "Admin Assist",
    "version": "1.3",
    "description": "Native 'Copy Details' button and one-click branch resync for Shopify Themes.",
    "permissions": [
        "clipboardWrite",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "https://admin.shopify.com/store/*/themes*",
        "https://auto-pr-bot.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://online-store-web.shopifyapps.com/*"
            ],
            "js": ["content.js"],
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/*.svg"],
            "matches": ["https://online-store-web.shopifyapps.com/*"]
        }
    ]
}