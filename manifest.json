{
    "manifest_version": 3,
    "name": "Admin Assist",
    "version": "1.5",
    "description": "Native 'Copy Details' button for Shopify Themes.",
    "browser_specific_settings": {
        "gecko": {
            "id": "admin-assist-shopify@ecomexperts.io",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "clipboardWrite",
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://online-store-web.shopifyapps.com/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*.svg"
            ],
            "matches": [
                "https://online-store-web.shopifyapps.com/*"
            ]
        }
    ]
}
